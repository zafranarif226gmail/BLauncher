# BLauncher Mod — environment variables
# Copy to your Cloudflare Pages project as SECRETS (dashboard → Settings → Environment variables),
# or run: npx wrangler pages secret put <NAME>
# NEVER commit real values of these to git (.env / real keys stay out of the repo).

# ---- Google sign-in ----
# OAuth 2.0 Web client ID from Google Cloud Console (public by design; no secret is used by this app)
GOOGLE_CLIENT_ID=

# ---- Sessions ----
# Random 32+ byte secret used to HMAC-sign the HttpOnly session cookie (openssl rand -hex 32)
SESSION_SECRET=

# ---- CurseForge proxy ----
# Official developer key from console.curseforge.com — kept SERVER-SIDE only, never shipped to browsers
CURSEFORGE_API_KEY=
# Only if CurseForge accepted your partner programme publishing authorization (optional)
CURSEFORGE_PUBLISH_AUTH=

# ---- Uploads / R2 ----
# Public variable (wrangler.toml [vars]) — configurable max upload size in MB
MAX_FILE_MB=100
# R2 binding name in wrangler.toml (binding must match: FILES) and bucket name
R2_BUCKET=blauncher-uploads

# ---- Dev only ----
# Local preview port used by docs (python3 -m http.server 8080)
DEV_PORT=8080
